use valuebounds;

fn main() {
    let value = 12.0;
    let minimum = 0.0;
    let maximum = 10.0;
    let result = valuebounds_check(value, minimum, maximum);
    if len(result) == 0 { println!("invalid"); return; }
    let mut i = 0;
    while i < len(result) {
        println!(at(result, i));
        i += 1;
    }
}
